# SB Insights — environment configuration.
# Copy to ".env" (same directory as run.py) and fill in. Real environment
# variables override these. api/main.py loads this file at startup.
# NOTE: never commit the real .env (it holds SECRET_KEY). Keep it 600/root-owned.

# REQUIRED in production --------------------------------------------------------
# Fernet key used for session signing AND encrypting stored OCS/email
# credentials. Without it the app uses an INSECURE fallback and logs a warning.
# Generate once:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: set this BEFORE saving any credentials — changing it later makes
# previously-encrypted OCS/email passwords undecryptable.
SECRET_KEY=

# Database path. SQLite for now; the schema is Postgres-portable for cloud.
TERROIR_DB=terroir.db

# Timezone — the backup (3am) and OCS connector (8pm) schedulers use the host's
# LOCAL clock. A cloud box defaults to UTC, so set this or they fire hours off.
TZ=America/Toronto

# Background schedulers (backup / email scraper / OCS connector) ----------------
# They're gated to a single instance via a lock file, so multiple web workers
# are safe. If you run a SEPARATE dedicated scheduler process, set this to 1 on
# the web workers so only the scheduler process runs them.
# TERROIR_NO_SCHEDULERS=1

# Per-feature kill switches (optional):
# TERROIR_DISABLE_BACKUPS=1
# TERROIR_DISABLE_SCRAPER=1
# TERROIR_DISABLE_OCS_CONNECTOR=1
# TERROIR_DISABLE_SUCCESSOR_MAP=1
